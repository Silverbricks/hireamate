DATABASE_URL="postgresql://ham:ham_dev_password@localhost:5433/hireamate?schema=public"
APP_URL="http://localhost:3000"
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Development only: demo account switcher + /dev/inbox. NEVER set in production.
ALLOW_DEMO_LOGIN="true"

# --- Optional providers (select them in Admin -> Settings & integrations) ---
# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HIRE A MATE <no-reply@yourdomain.com.au>"
# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Maps (Google Geocoding)
GOOGLE_MAPS_API_KEY=""

# --- Production safety (SRS v1.3 s27) ---
# In production the server refuses to start without AUTH_SECRET (32+ chars) and an https APP_URL,
# and refuses ALLOW_DEMO_LOGIN=true. Console/simulated providers refuse to send or charge.
# Licensed map tiles (e.g. MapTiler/Mapbox URL template with key). Maps are disabled in production without it.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""
# Local runs of a production build only (next start / E2E): HAM_ENV="local". NEVER set this on a deployed environment.
